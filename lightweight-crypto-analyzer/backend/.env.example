# Copy this file to .env and adjust as needed. Never commit real secrets.

# Port the Express API listens on.
PORT=5000

# Comma-separated list of origins allowed by CORS (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Maximum plaintext size accepted by /api/encrypt and /api/decrypt (bytes).
MAX_PLAINTEXT_BYTES=65536

# Set to "true" to log one line per request (method, path, status, duration).
# Request bodies (plaintext, keys, ciphertext) are never logged.
LOG_REQUESTS=true
